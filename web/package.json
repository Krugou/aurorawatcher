{
  "name": "aurorawatcher-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3005",
    "dev:advanced": "vite --host --port 3005 --open --cors",
    "start": "vite preview --port 3005",
    "test": "vitest --passWithNoTests",
    "test:e2e": "start-server-and-test dev http://localhost:3005 \"cypress run\"",
    "cy:open": "cypress open",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "suncalc": "^2.0.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^15.21.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1",
    "@tailwindcss/oxide-linux-x64-gnu": "*",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  }
}
